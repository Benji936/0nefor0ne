{
  "name": "0nefor-one-remote-duel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord Activity — a synced remote-duel companion (life points, coin, dice, first turn, timer) for the 0nefor.one Yu-Gi-Oh marketplace.",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PORT=3001 node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "vue": "^3.4.38",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "concurrently": "^9.0.1",
    "vite": "^5.4.6"
  }
}
