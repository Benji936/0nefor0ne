{
  "name": "0nefor-one-remote-duel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord Activity — a synced remote-duel companion (life points, coin, dice, first turn, timer) for the 0nefor.one Yu-Gi-Oh marketplace. Runs on Cloudflare Workers + Durable Objects.",
  "scripts": {
    "dev": "concurrently -k -n vite,worker \"vite build --watch\" \"wrangler dev\"",
    "build": "vite build",
    "test": "node --test shared/*.test.js worker/*.test.js",
    "deploy": "npm run build && wrangler deploy",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "concurrently": "^9.0.1",
    "vite": "^5.4.6",
    "wrangler": "^4.118.0"
  }
}
