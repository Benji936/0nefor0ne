# Discord app (SAME app as the bot — application id 1523756849051205692)
# Dev Portal -> your app -> OAuth2
DISCORD_CLIENT_ID=1523756849051205692
DISCORD_CLIENT_SECRET=your-oauth2-client-secret

# Build-time value for the frontend (Vite only exposes VITE_-prefixed vars).
# Must equal DISCORD_CLIENT_ID. On Railway, set this as a service Variable too,
# because it is read during `npm run build`.
VITE_DISCORD_CLIENT_ID=1523756849051205692

# Server port (Railway injects PORT automatically; this is for local dev).
PORT=3001
