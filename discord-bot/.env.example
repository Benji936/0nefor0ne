# Used to (a) filter entitlements and (b) render the premium upgrade button.
DISCORD_PREMIUM_SKU_ID=

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ────────────────────────────────────────────────────────────────────────
APP_URL=https://0nefor.one
